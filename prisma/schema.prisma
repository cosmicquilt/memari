// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
}

enum BaseType {
  WEEK
  MONTH
  QUARTER
  YEAR
}

// A planner a user is building. `isTemplate` marks the small set of
// prebuilt starter planners (weekly/monthly/quarterly/yearly "bases")
// that get cloned into a new owned Planner when a user starts fresh.
model Planner {
  id         String   @id @default(cuid())
  // Clerk user ID. Not an FK yet — syncing Clerk users into our own
  // `User` table via webhook is a later task, not a blocker for this.
  ownerId    String
  title      String
  baseType   BaseType
  isTemplate Boolean  @default(false)
  theme      Json?
  pages      Page[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId])
}

// A single page within a planner, in display order. Every page has a grid
// — it's the standing default placement system — but individual modules
// can opt out to free placement via ModuleInstance.placementMode.
model Page {
  id              String           @id @default(cuid())
  plannerId       String
  planner         Planner          @relation(fields: [plannerId], references: [id], onDelete: Cascade)
  position        Int
  // 4 columns so a 1-column sidebar is exactly 25% width, matching the
  // reference PDF's proportions. 30 rows / 12px gap — reverted from a
  // brief detour to 35/10 that was based on a slack calculation missing
  // the (rowSpan-1)*gap term a multi-row component's own height also
  // includes; once computed correctly, 30/12 already gives near-zero
  // slack (see hourly-grid-core's defaultRowSpan in prisma/seed.mts).
  gridColumns     Int              @default(4)
  gridRows        Int              @default(30)
  gridGapPx       Float            @default(12)
  marginPx        Float            @default(75)
  moduleInstances ModuleInstance[]

  @@unique([plannerId, position])
}

// The "class" of a draggable block: weekly-grid, habit-tracker, etc.
// Config shape varies per type, so it's stored as a JSON schema rather
// than fixed columns. default{Width,Height} are the freeform-page
// fallback size; default{ColumnSpan,RowSpan} are the grid-page fallback.
model ModuleType {
  id                 String           @id @default(cuid())
  slug               String           @unique
  name               String
  configSchema       Json
  defaultWidth       Float
  defaultHeight      Float
  defaultColumnSpan  Int              @default(1)
  defaultRowSpan     Int              @default(1)
  instances          ModuleInstance[]
}

enum ModulePlacementMode {
  GRID
  FREE
}

// A placed instance of a ModuleType on a specific Page. placementMode
// decides which set of fields below is authoritative for this specific
// instance — independent of other instances on the same page, so a page
// can mix grid-placed and free-placed modules.
model ModuleInstance {
  id            String              @id @default(cuid())
  pageId        String
  page          Page                @relation(fields: [pageId], references: [id], onDelete: Cascade)
  moduleTypeId  String
  moduleType    ModuleType          @relation(fields: [moduleTypeId], references: [id])

  placementMode ModulePlacementMode @default(GRID)
  // "Core" blocks (hourly-grid-core, month-calendar-core) are locked by
  // default: not draggable/resizable in the editor, even though they're
  // architecturally just another ModuleInstance. Their internal settings
  // (start/end time, line style, etc.) stay editable via propValues.
  locked        Boolean             @default(false)

  // Used when placementMode = FREE.
  x             Float?
  y             Float?
  width         Float?
  height        Float?

  // Used when placementMode = GRID (0-indexed).
  columnStart   Int?
  rowStart      Int?
  columnSpan    Int                 @default(1)
  rowSpan       Int                 @default(1)

  zIndex        Int                 @default(0)
  propValues    Json                @default("{}")

  @@index([pageId])
}
