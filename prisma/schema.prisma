// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
}

// How often a page REPEATS in the finished book.
//
// You design each level once and the book is stamped out from it: a WEEKLY
// page is printed for every week in the planner's date range, a DAILY one
// for every day. Front and back matter are printed once. That is the whole
// of sequence generation, and it is also the price dial - a per-day module
// prints ~90 times in a quarter where a per-month one prints 3.
//
// DECLARATION ORDER IS BINDING ORDER. Postgres sorts an enum by the order
// its values were declared, so `ORDER BY level` is the order the pages are
// bound in, and the timeline reads left to right off the same query.
//
// FRONT_MATTER / BACK_MATTER rather than BEGINNING / ENDING: those are the
// names on screen and Andrew has said they may change. A display label is a
// string in one file; an enum value is a migration.
enum PageLevel {
  FRONT_MATTER
  MONTHLY
  WEEKLY
  DAILY
  BACK_MATTER
}

// A planner a user is building. `isTemplate` marks the small set of
// prebuilt starter planners (weekly/monthly/quarterly/yearly "bases")
// that get cloned into a new owned Planner when a user starts fresh.
model Planner {
  id         String    @id @default(cuid())
  // Clerk user ID. Not an FK yet — syncing Clerk users into our own
  // `User` table via webhook is a later task, not a blocker for this.
  ownerId    String
  title      String
  // Does this planner carry DATES, or is it a template you write them into?
  // The free tier is the undated one (see the business model: the book is
  // derived from templates, and a template has no dates). Undated is applied
  // at read time - loadPlannerPages strips the date values out of what it
  // renders - so the stored propValues keep whatever dates were entered and
  // turning this back on restores them rather than re-seeding.
  // Defaults true: every planner that existed before this column did was a
  // dated one, and a default that silently blanked them would be a migration
  // that deleted content.
  dated      Boolean   @default(true)
  // What term this book covers. Sequence generation turns the templates
  // into pages by walking this range - so many weeks, so many days.
  // Nullable: every planner that existed before this was a single spread
  // with no term at all, and a made-up range would be a lie about what
  // somebody built.
  startDate  DateTime?
  endDate    DateTime?
  // The zone this book's clock reads (an IANA name). Every event is an
  // INSTANT, and a page draws it at its wall-clock time here - a book, not a
  // person, because a planner is printed for a place: a travel journal for a
  // term in London reads London time wherever its owner lives. Andrew,
  // 2026-09-28: "per book".
  // NULL MEANS "FOLLOW MY DEFAULT" - OwnerSettings.timeZone. Andrew,
  // 2026-09-28: the zone should also "have a user default though and be able
  // to be changed". So a book either follows the person's default, and moves
  // when they change it, or has a zone of its own and stays put. Every book
  // made before zones existed follows the default, which is what it would
  // have chosen. See effectiveZone in src/lib/timeZone.ts - the one place
  // the two are combined.
  timeZone   String?
  isTemplate Boolean   @default(false)
  theme      Json?
  pages      Page[]
  printOrders PrintOrder[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([ownerId])
}

// A single page within a planner, in display order. Every page has a grid
// — it's the standing default placement system — but individual modules
// can opt out to free placement via ModuleInstance.placementMode.
model Page {
  id              String           @id @default(cuid())
  plannerId       String
  planner         Planner          @relation(fields: [plannerId], references: [id], onDelete: Cascade)
  // Which repeating set this page belongs to, and its order WITHIN that
  // set - so position 0 is the first page of the weeklies, not the first
  // page of the book. A spread is two consecutive positions.
  //
  // No default, deliberately. There is no sensible universal answer to
  // "what level is a page whose level nobody stated", and a default of
  // WEEKLY would silently swallow a daily page created without one. The
  // migration adds the column with a default, backfills, and drops the
  // default again, so every writer has to say.
  level           PageLevel
  // WHICH OCCURRENCE of the level this page is for.
  //
  // null is the DEFAULT layout - the one printed for every occurrence that
  // has none of its own, which is almost all of them. A key like "2026-01"
  // is a layout for that month alone: the generator takes a month's own
  // pages when they exist and the default ones when they do not.
  //
  // "Repeat by default, customise by exception" is the whole product model
  // here - most people buy a month or ninety days and want one weekly spread
  // repeated, so the exception has to cost nothing when unused. One nullable
  // column is that cost.
  variantKey      String?
  position        Int
  // 24 columns x 36 rows of exactly 75 x 75 print px - one cell is one
  // 1/4in dot at 300dpi, and the cell is square. The margin follows from
  // wanting whole dots rather than the other way round: 24 dots is
  // 1800px, so (2175 - 1800) / 2 = 187.5px each side, and 36 dots is
  // 2700px, so (3075 - 2700) / 2 = 187.5px - the same number on both
  // axes, with no residue on either. That is 0.5in in from the trim.
  //
  // A day column is 6 dots (1.500in) and the sidebar is one of four such
  // units, so the sidebar stays exactly 1/8 of the spread.
  //
  // gridGapPx is gone from the coordinate system: see PageGrid.boxInsetPx
  // in src/lib/grid.ts. The column still exists and is read as an inset of
  // half its value, which is why it is 12 rather than 6 here.
  // The page's own pixel size at 300dpi, INCLUDING any bleed. Data, not a
  // constant, because a planner is exported at more than one trim: 7x10
  // bound (2175 x 3075, a 7x10 trim plus 0.125in bleed each edge) or US
  // Letter printed at home (2550 x 3300, no bleed - nothing is trimmed).
  //
  // Both land 24 dots of content across, which is what keeps one design
  // valid at either size: Letter simply spends its extra width on margin.
  // 2550 - 24*75 = 750, so 375px = 1.25in each side; the same 375px
  // vertically leaves (3300 - 750) / 75 = 34 whole rows.
  widthPx         Float            @default(2175)
  heightPx        Float            @default(3075)
  gridColumns     Int              @default(24)
  gridRows        Int              @default(36)
  gridGapPx       Float            @default(12)
  marginPx        Float            @default(187.5)
  moduleInstances ModuleInstance[]
  // A LINKED COPY of a saved page or spread, or null for a page of this
  // journal's own. Every copy of one saved page holds the same modules:
  // an edit to any of them is copied to the others and to the saved item
  // itself - see src/app/planner/savedItems.ts. savedPageIndex is which
  // page of the saved item this is: 0, or 1 for a spread's right page.
  savedPageId     String?
  savedPage       SavedPage?       @relation(fields: [savedPageId], references: [id], onDelete: SetNull)
  savedPageIndex  Int?

  // Position is position within a LEVEL AND A VARIANT: the default weekly
  // spread has pages 0 and 1, and so does January's own monthly spread.
  //
  // The index is created by hand as NULLS NOT DISTINCT (Postgres 15+), which
  // Prisma cannot express. Without it the default pages - the ones with a
  // null variantKey, which is most of them - would not be covered by the
  // constraint at all, since Postgres treats each NULL as distinct.
  @@unique([plannerId, level, variantKey, position], map: "Page_plannerId_level_variantKey_position_key")
  @@index([savedPageId])
}

// The "class" of a draggable block: weekly-grid, habit-tracker, etc.
// Config shape varies per type, so it's stored as a JSON schema rather
// than fixed columns. default{Width,Height} are the freeform-page
// fallback size; default{ColumnSpan,RowSpan} are the grid-page fallback.
model ModuleType {
  id                String           @id @default(cuid())
  slug              String           @unique
  name              String
  configSchema      Json
  defaultWidth      Float
  defaultHeight     Float
  defaultColumnSpan Int              @default(1)
  defaultRowSpan    Int              @default(1)
  instances         ModuleInstance[]
  savedModules      SavedModule[]
}

enum ModulePlacementMode {
  GRID
  FREE
}

// A placed instance of a ModuleType on a specific Page. placementMode
// decides which set of fields below is authoritative for this specific
// instance — independent of other instances on the same page, so a page
// can mix grid-placed and free-placed modules.
model ModuleInstance {
  id           String     @id @default(cuid())
  pageId       String
  page         Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  moduleTypeId String
  moduleType   ModuleType @relation(fields: [moduleTypeId], references: [id])

  placementMode ModulePlacementMode @default(GRID)
  // "Core" blocks (hourly-grid-core, month-calendar-core) are locked by
  // default: not draggable/resizable in the editor, even though they're
  // architecturally just another ModuleInstance. Their internal settings
  // (start/end time, line style, etc.) stay editable via propValues.
  locked        Boolean             @default(false)

  // Used when placementMode = FREE.
  x      Float?
  y      Float?
  width  Float?
  height Float?

  // Used when placementMode = GRID (0-indexed).
  columnStart Int?
  rowStart    Int?
  columnSpan  Int  @default(1)
  rowSpan     Int  @default(1)

  zIndex     Int  @default(0)
  propValues Json @default("{}")

  // A LINKED use of a saved module: its settings are the saved module's,
  // and changing them here changes every use. Placement stays this
  // instance's own - one saved tracker can sit in a sidebar here and full
  // width there. See src/app/planner/savedItems.ts.
  savedModuleId String?
  savedModule   SavedModule? @relation(fields: [savedModuleId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@index([savedModuleId])
}

// A page or a two-page spread somebody saved to use again - Saved > Pages.
//
// LINKED, not copied (Andrew, 2026-09-21: "for now it can just change all
// of them"): the pages it is used on are real pages carrying savedPageId,
// and an edit to any one of them is copied to the rest and to `content`
// here. `content` is what a new use is made from, and what the saved item
// still holds after every page using it has gone.
//
// It keeps the SIZE it was saved at, and is only offered to journals of
// that size: a 34-row Letter page does not fit a 36-row 7x10 one.
model SavedPage {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  // 1 for a page, 2 for a spread.
  pageCount   Int
  widthPx     Float
  heightPx    Float
  gridColumns Int
  gridRows    Int
  gridGapPx   Float
  marginPx    Float
  // SavedPageContent - one list of module slots per page. See savedItems.ts.
  content     Json
  pages       Page[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
}

// A module somebody saved with its settings - Saved > Modules. Linked the
// same way: every instance carrying savedModuleId shows these propValues.
// columnSpan/rowSpan are the size it was saved at, for the preview only;
// a placed use takes the size of wherever it is dropped.
model SavedModule {
  id           String           @id @default(cuid())
  ownerId      String
  name         String
  moduleTypeId String
  moduleType   ModuleType       @relation(fields: [moduleTypeId], references: [id])
  propValues   Json             @default("{}")
  columnSpan   Int
  rowSpan      Int
  instances    ModuleInstance[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([ownerId])
}

// --- Calendars and events --------------------------------------------------
//
// PER OWNER, NOT PER JOURNAL (Andrew, 2026-09-26). Your calendar is yours: a
// dentist appointment should appear in whichever journal covers that week,
// and importing the same Google calendar once per journal would be absurd.
// A journal chooses which calendars it SHOWS - see HiddenCalendar.
//
// The book is derived from templates and never stored (see
// memari-sequence-generation), and a module dates itself through the
// registry's `dated(props, at)` hook. An event is dated, so it cannot live in
// a template's propValues; it lives here, and hourly-grid-core's hook fills
// its `events` for the occurrence being drawn.
//
// Both models must be added to claimGuestWork, or a guest who signs in loses
// their calendar.

/// How an event came to be here. Sync must never push back something it just
/// read, and a photo import has to be reviewable as a batch.
enum EventOrigin {
  TYPED
  IMPORTED
  PHOTO
}

model Calendar {
  id         String           @id @default(cuid())
  /// Clerk user id, or `guest:<32 hex>` - see src/lib/owner.ts.
  ownerId    String
  name       String
  /// Drawn on screen; print takes grey (Andrew, 2026-09-26) - colour pages
  /// cost money, so the colour is a screen affordance until asked for.
  colour     String
  /// Where it came from: google | icloud | outlook | ics. Null means it was
  /// made here.
  source     String?
  /// The provider's own id for this calendar, and its sync cursor.
  externalId String?
  syncToken  String?
  events     CalendarEvent[]
  hiddenIn   HiddenCalendar[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([ownerId, source, externalId])
  @@index([ownerId])
}

model CalendarEvent {
  id         String   @id @default(cuid())
  ownerId    String
  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  title    String
  /// UTC instants. `timeZone` is the zone the event was AUTHORED in, kept
  /// because a weekly recurrence has to stay at 9am across a DST boundary -
  /// storing only the instant silently shifts a whole term.
  /// "floating" is iCalendar's time with no zone - "9am wherever you are" -
  /// and is drawn at that wall time in every book. Typed events from before
  /// books had zones were migrated to it, because that is what they were.
  startsAt DateTime
  endsAt   DateTime
  timeZone String   @default("UTC")
  /// Drawn in the banner row above the hours, with holidays - which are
  /// themselves just an imported calendar of all-day events.
  allDay   Boolean  @default(false)

  /// RFC 5545. Null for a one-off. Kept as the rule rather than expanded into
  /// rows so that editing one instance of an imported series does not explode
  /// it into fifty-two rows that then fight the server's copy.
  rrule String?

  origin       EventOrigin @default(TYPED)
  /// The provider's id and version, for a round trip without duplication.
  externalId   String?
  etag         String?
  lastSyncedAt DateTime?

  /// SYNC CARGO: stored so a round trip does not wipe it, never shown and
  /// never printed. Andrew, 2026-09-26: "we dont need location for our, I
  /// want it to be simplistic."
  location String?

  /// A tombstone, not a delete. Without it a local deletion is invisible to
  /// sync and the event returns on the next pull.
  deletedAt DateTime?

  overrides CalendarEventOverride[]
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([calendarId, externalId])
  @@index([ownerId, startsAt])
  @@index([calendarId])
}

/// One instance of a recurring event moved, retitled or cancelled.
model CalendarEventOverride {
  id           String        @id @default(cuid())
  eventId      String
  event        CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// The instance's ORIGINAL start, which is how RFC 5545 names an instance.
  recurrenceId DateTime
  cancelled    Boolean       @default(false)
  title        String?
  startsAt     DateTime?
  endsAt       DateTime?

  @@unique([eventId, recurrenceId])
}

/// Which calendars a journal does NOT show.
///
/// Presence means hidden; absence means shown. That way a calendar added or
/// imported later appears in every journal at once instead of being invisible
/// until you go and tick it in each one - the same discipline as undated
/// being the absence of the date values rather than a flag.
model HiddenCalendar {
  plannerId  String
  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@id([plannerId, calendarId])
  @@index([calendarId])
}

/// Per-person settings, keyed by the same ownerId journals are: a Clerk user
/// id, or `guest:<32 hex>` - see src/lib/owner.ts. There is no User table
/// (Clerk holds the account), so this is where a preference that belongs to
/// the PERSON rather than to one book lives.
model OwnerSettings {
  ownerId   String   @id
  /// The zone every book follows unless it has one of its own. STORED, not
  /// read from the browser each time: the PDF is drawn on the server, which
  /// has no browser, and two devices in two zones must not print the same
  /// book two ways. Seeded from the browser the first time it is missing.
  timeZone  String?
  /// The person's customer at Stripe, made the first time they order, so
  /// every order and any renewal is one customer with one saved card.
  stripeCustomerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Ordering a printed book (2026-10-04) ───────────────────────────────────
// "start on checkout": one-off books of any number of days, coil, paperback
// or hardcover, shipped worldwide, with auto-renew off unless turned on.
// See src/lib/print.

enum PrintBinding {
  COIL
  PAPERBACK
  HARDCOVER
}

enum PrintOrderStatus {
  /// Files built and priced; nothing paid.
  QUOTED
  /// Paid; not yet with the printer.
  PAID
  /// A print job exists at Lulu, which has charged us for it.
  SUBMITTED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELED
  /// Lulu rejected it, or a step failed - someone has to look.
  FAILED
}

/// One printed book, from the price shown to the parcel delivered.
///
/// A SNAPSHOT, not a pointer: the title, dates, page count and the PDFs
/// themselves are copied in when it is priced, so what is paid for is what
/// prints - editing the journal afterwards changes the next book, never this
/// one - and the order outlives the journal it came from.
model PrintOrder {
  id        String           @id @default(cuid())
  ownerId   String
  /// The journal it was made from; cleared, not deleted with it.
  plannerId String?
  planner   Planner?         @relation(fields: [plannerId], references: [id], onDelete: SetNull)
  status    PrintOrderStatus @default(QUOTED)

  title      String
  /// First and last day covered, both included; `days` of them.
  startDate  DateTime
  endDate    DateTime
  days       Int
  binding    PrintBinding
  /// Lulu's SKU - see src/lib/print/products.ts.
  podPackageId String
  /// Printed pages, padded to a multiple of four.
  pageCount  Int

  /// MAIL, PRIORITY_MAIL, GROUND, EXPEDITED or EXPRESS.
  shippingLevel   String
  /// Where it goes, as entered - see ShippingAddress in src/lib/print/lulu.ts.
  shippingAddress Json
  contactEmail    String?

  /// What the customer pays, in cents of `currency`.
  bookCents     Int
  shippingCents Int
  totalCents    Int
  currency      String @default("USD")
  /// What Lulu quoted to charge us, tax included.
  costCents     Int

  /// Off unless turned on. When on, the next book - the same number of days
  /// straight after this one - is charged and ordered on `renewsAt`.
  autoRenew Boolean   @default(false)
  renewsAt  DateTime?
  /// The order this one renewed, if it was a renewal.
  renewedFromId String?
  renewedFrom   PrintOrder?  @relation("Renewals", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewals      PrintOrder[] @relation("Renewals")

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?
  /// The card saved for renewals - only when auto-renew was on at payment.
  stripePaymentMethodId   String?

  luluPrintJobId String?
  /// Lulu's own status name, as last reported.
  luluStatus     String?
  trackingUrls   Json?
  /// Why it FAILED, in words someone can act on.
  failureReason  String?

  files PrintFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status, renewsAt])
}

/// A print-ready PDF of an order: its interior or its cover, kept with the
/// order so Lulu fetches exactly what was priced (src/app/api/print-files).
model PrintFile {
  id        String     @id @default(cuid())
  orderId   String
  order     PrintOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// "interior" or "cover".
  kind      String
  bytes     Bytes
  createdAt DateTime   @default(now())

  @@unique([orderId, kind])
}
