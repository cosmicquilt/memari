// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
}

enum BaseType {
  WEEK
  MONTH
  QUARTER
  YEAR
}

// A planner a user is building. `isTemplate` marks the small set of
// prebuilt starter planners (weekly/monthly/quarterly/yearly "bases")
// that get cloned into a new owned Planner when a user starts fresh.
model Planner {
  id         String   @id @default(cuid())
  // Clerk user ID. Not an FK yet — syncing Clerk users into our own
  // `User` table via webhook is a later task, not a blocker for this.
  ownerId    String
  title      String
  baseType   BaseType
  isTemplate Boolean  @default(false)
  theme      Json?
  pages      Page[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId])
}

// A single page within a planner, in display order.
//
// Grid fields are nullable: null means this page is freeform (its modules'
// x/y/width/height are authoritative). Set means this page is grid-based
// (its modules' column/row fields are authoritative, and pixel geometry is
// computed from the grid at render/export time via gridCellToPixels()).
model Page {
  id              String           @id @default(cuid())
  plannerId       String
  planner         Planner          @relation(fields: [plannerId], references: [id], onDelete: Cascade)
  position        Int
  gridColumns     Int?
  gridRows        Int?
  gridGapPx       Float?           @default(0)
  moduleInstances ModuleInstance[]

  @@unique([plannerId, position])
}

// The "class" of a draggable block: weekly-grid, habit-tracker, etc.
// Config shape varies per type, so it's stored as a JSON schema rather
// than fixed columns. default{Width,Height} are the freeform-page
// fallback size; default{ColumnSpan,RowSpan} are the grid-page fallback.
model ModuleType {
  id                 String           @id @default(cuid())
  slug               String           @unique
  name               String
  configSchema       Json
  defaultWidth       Float
  defaultHeight      Float
  defaultColumnSpan  Int              @default(1)
  defaultRowSpan     Int              @default(1)
  instances          ModuleInstance[]
}

// A placed instance of a ModuleType on a specific Page. Exactly one of
// the two placement modes below is populated, matching the Page's mode.
model ModuleInstance {
  id           String     @id @default(cuid())
  pageId       String
  page         Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  moduleTypeId String
  moduleType   ModuleType @relation(fields: [moduleTypeId], references: [id])

  // Freeform placement (pages with no grid configured).
  x            Float?
  y            Float?
  width        Float?
  height       Float?

  // Grid placement (pages with gridColumns/gridRows set). 0-indexed.
  columnStart  Int?
  rowStart     Int?
  columnSpan   Int        @default(1)
  rowSpan      Int        @default(1)

  zIndex       Int        @default(0)
  propValues   Json       @default("{}")

  @@index([pageId])
}
