# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# clerk configuration (can include secrets)
/.clerk/

# local dev server log
memari-dev.log

# Generated by src/lib/todoProof.mts for eyeballing module renders.
public/todo-proof.html

# Generated by npm run check:proof - a look-at-it artifact, not source.
public/primitive-proof.html

# Same: generated to be looked at, regenerated on every run.
# public/catalogue.html is the local copy of the review page; the one that
# ships is docs/index.html, which IS committed because Pages serves it.
public/catalogue-proof.html
public/catalogue.html

# Generated by npm run check:undated - the undated/dated comparison, drawn
# by the real renderers. Same as the others: look at it, do not commit it.
public/undated-proof.html
public/planner-*.pdf

# Generated by npm run check:book - the whole book, for looking at. An
# artefact, not source.
public/book.pdf
